#!/usr/bin/env node
// `og` → the bundled public CLI (og-public.mjs). This shim exists so the command
// on PATH is named `og` — what the develop-app skill invokes — while the bundle
// keeps its descriptive filename. Spawning (rather than importing the bundle's
// shebang'd module) keeps it robust across Node versions and independent of the
// caller's cwd. (#1318)
import { spawnSync } from "node:child_process";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const bundle = join(dirname(fileURLToPath(import.meta.url)), "og-public.mjs");
// Announce the name we were invoked as, so every hint the bundle prints ("run
// `og login`") names a command that's actually on the caller's PATH. argv can't
// carry this: we SPAWN the bundle, so its argv[1] is og-public.mjs regardless.
// --disable-warning=DEP0169 silences Node 24's url.parse() deprecation, raised
// by faye-websocket (the Firebase SDK's Node RTDB transport) the moment a
// command opens the database — not our code. Targeted, so every other warning
// still shows; not NODE_OPTIONS, which would leak into child processes. (#2450)
// Behind an egress proxy (a sandbox, a cloud session) Node's fetch, which the
// Firebase Auth, Storage and Functions SDKs use, ignores HTTPS_PROXY unless
// NODE_USE_ENV_PROXY is set (Node 22.21+/24.5+; older Node ignores the flag).
// The database's websocket reads HTTPS_PROXY itself. (#2624)
// The flag makes Node warn "EnvHttpProxyAgent is experimental" (UNDICI-EHPA)
// at the top of every command's output, so that warning is silenced with it.
const proxied = Boolean(process.env.HTTPS_PROXY || process.env.https_proxy);
const res = spawnSync(
  process.execPath,
  [
    "--disable-warning=DEP0169",
    ...(proxied ? ["--disable-warning=UNDICI-EHPA"] : []),
    bundle,
    ...process.argv.slice(2),
  ],
  {
    stdio: "inherit",
    env: {
      ...(proxied && { NODE_USE_ENV_PROXY: "1" }),
      ...process.env,
      OG_CLI_NAME: "og",
    },
  },
);
process.exit(res.status ?? 1);
