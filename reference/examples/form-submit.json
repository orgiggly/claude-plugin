{
  "_comment": "Pattern: Form screen with formConfig bound to an object type, submit and cancel buttons. Save composes a script with a navigation in ONE declared action — `submit()` runs first, and only if it succeeds does the `pop` navigation run, so a failed save leaves the user on the form with their input intact.",
  "appConfig_excerpt": {
    "edit_screen_in_components_folder": {
      "id": "screen-5",
      "type": "screen",
      "label": "Edit Contact",
      "name": "editContact",
      "layout": { "maxColumns": 1, "axis": "y", "mode": "columns", "minColumnWidth": 350 },
      "data": { "source": "embedded" },
      "_children": [
        {
          "id": "form-1",
          "type": "form",
          "label": "Contact Form",
          "name": "contactForm",
          "formConfig": { "dataType": "Contact" }
        },
        {
          "id": "content-7",
          "type": "content",
          "name": "formActions",
          "htmlTemplate": "@`<div style=\"display: flex; gap: 12px; margin-top: 16px;\">\n  <button data-action=\"save\" style=\"padding: 12px 24px; background: #3b82f6; color: white; border: none; border-radius: 8px; font: inherit; font-weight: 600; cursor: pointer;\">Save</button>\n  <button data-action=\"cancel\" style=\"padding: 12px 24px; background: #e2e8f0; color: #333; border: none; border-radius: 8px; font: inherit; cursor: pointer;\">Cancel</button>\n</div>`",
          "actions": {
            "save": { "script": "submit(); back()" },
            "cancel": { "script": "back()" }
          }
        }
      ]
    }
  },
  "objectTypes_excerpt": [
    {
      "id": "objectType-1",
      "type": "objectType",
      "name": "Contact",
      "icon": "person",
      "fields": [
        { "name": "name", "type": "text" },
        { "name": "email", "type": "text" },
        { "name": "phone", "type": "text" },
        { "name": "notes", "type": "text", "variant": "multiline" }
      ]
    }
  ]
}
